meta {
  name: Stats
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/stats?date=2026-08-19
  body: none
  auth: none
}

params:query {
  date: 2026-08-19
}

docs {
  Server-rendered HTML statistics page for one day (defaults to today,
  `YYYY-MM-DD`). Shows totals overall and per line: total departures,
  cancelled departures, total bookings, cancelled bookings, seats booked
  and revenue.
}
