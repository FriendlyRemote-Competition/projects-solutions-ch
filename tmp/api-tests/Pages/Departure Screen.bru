meta {
  name: Departure Screen
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/board/DCL?limit=8
  body: none
  auth: none
}

params:query {
  limit: 8
}

docs {
  Server-rendered HTML departure screen for one pier, showing the next
  departures (even if on the next day). `limit` 1 to 20, default 8.
  Refreshes itself every 10 seconds. Not found page if the station is unknown.
}
