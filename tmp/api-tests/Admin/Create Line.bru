meta {
  name: Create Line
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/lines
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "code": "WS",
    "name": "Wusong Line",
    "station_a_code": "TQO",
    "station_b_code": "GPR",
    "seat_capacity": 30,
    "crossing_minutes": 14,
    "fare_cny": "3.00",
    "status": "active"
  }
}

docs {
  admin only. Creates a new line (with no service windows yet).

  Validation (422 on failure):
  - `code` required, 2-4 uppercase letters, unique
  - both stations must exist and be different
  - `seat_capacity` 1-500
  - `crossing_minutes` 1-120
  - `fare_cny` decimal 0 to 999.99
  - `status` optional, `active` or `suspended`, default `active`
}
