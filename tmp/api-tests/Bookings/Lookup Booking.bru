meta {
  name: Lookup Booking
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/bookings/lookup
  body: json
  auth: none
}

body:json {
  {
    "booking_code": "{{bookingCode}}",
    "first_name": "lin",
    "last_name": " WEI "
  }
}

docs {
  Retrieve a booking by its code plus the customer name.
  Names are compared case-insensitively and with surrounding whitespace ignored.
  Returns 404 if the code does not exist or the names do not match.
}
